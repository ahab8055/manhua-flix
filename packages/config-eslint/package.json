{
  "name": "@manhua-flix/config-eslint",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/base.js",
  "module": "./dist/base.mjs",
  "exports": {
    ".": {
      "import": "./dist/base.mjs",
      "require": "./dist/base.js"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./nestjs": {
      "import": "./dist/nestjs.mjs",
      "require": "./dist/nestjs.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  }
}
